---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI SEO Lab experiments, content variants, and research notes.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Lang Forge</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #14213d;
        --muted: #586174;
        --paper: #fffaf0;
        --surface: #ffffff;
        --accent: #fca311;
        --line: #e5e7eb;
      }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.6;
      }
      a { color: inherit; }
      header.site-header, footer.site-footer {
        background: var(--ink);
        color: white;
      }
      .site-header__inner, .site-footer__inner, main {
        width: min(1040px, calc(100% - 32px));
        margin: 0 auto;
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 18px 0;
      }
      .brand {
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
      }
      nav ul {
        display: flex;
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      main { padding: 48px 0 64px; }
      .hero, .card, .content-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 16px 40px rgb(20 33 61 / 0.08);
      }
      .hero { padding: 40px; }
      .eyebrow {
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      h1, h2, h3 { line-height: 1.15; }
      .grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }
      .card, .content-panel { padding: 24px; }
      .muted { color: var(--muted); }
      .pill {
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 10px;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .site-footer__inner { padding: 24px 0; }
      .variant {
        padding: 24px;
        background: white;
        border: 1px solid var(--line);
        border-radius: 18px;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">Lang Forge</a>
        <nav aria-label="Primary navigation">
          <ul>
            <li><a href="/">Experiments</a></li>
            <li><a href="/sitemap-index.xml">Sitemap</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">AI SEO Lab · controlled experiments for how machines read the web.</div>
    </footer>
  </body>
</html>
