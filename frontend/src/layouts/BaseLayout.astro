---
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI SEO Lab experiments, content variants, and research notes.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/nova-mark-badge.svg" />
    <title>{title} | lang-forge</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light')
            document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Cambiar tema"
    >☾ oscuro</button>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <img src="/nova-mark-badge.svg" width="28" height="28" alt="Nova mark" />
          lang-forge
        </a>
        <nav aria-label="Primary navigation">
          <ul>
            <li><a href="/">Experiments</a></li>
            <li><a href="/sitemap-index.xml">Sitemap</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="tagline">AI SEO Lab · controlled experiments for how machines read the web.</p>
        <p class="suite">
          <img src="/nova-mark-badge.svg" width="16" height="16" alt="" />
          lang-forge · parte de la suite «todo es lenguaje» ·
          <a href="https://x.com/rodrigoscz_">@rodrigoscz_</a> ·
          <a href="https://github.com/rodrigoscz/lang-forge">repo</a>
        </p>
      </div>
    </footer>

    <style is:global>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
        color: var(--ink);
        background: var(--arena);
        line-height: 1.55;
      }
      a {
        color: var(--terra);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      a:hover {
        border-bottom-color: var(--terra);
      }
      a:focus-visible {
        outline: 2px solid var(--terra);
        outline-offset: 2px;
        border-radius: 2px;
      }

      .site-header__inner,
      .site-footer__inner,
      main {
        width: min(880px, calc(100% - 32px));
        margin: 0 auto;
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        background: var(--paper);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 16px 0;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--ink);
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: lowercase;
        border-bottom: none;
      }
      .brand img {
        image-rendering: pixelated;
      }
      nav ul {
        display: flex;
        gap: 18px;
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.85rem;
      }

      main {
        padding: 48px 0 64px;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        letter-spacing: 0.02em;
      }
      h2 {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brown);
        border-bottom: 2px solid var(--line);
        padding-bottom: 0.3rem;
        margin: 0 0 0.9rem;
      }

      .hero,
      .card,
      .content-panel {
        background: var(--paper);
        border: 2px solid var(--line);
        border-radius: 10px;
      }
      .hero {
        padding: 40px;
      }
      .hero h1 {
        margin: 0.4rem 0 0.6rem;
        font-size: 2rem;
        color: var(--terra);
      }
      .eyebrow {
        color: var(--terra);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0;
      }
      .grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }
      .card,
      .content-panel {
        padding: 24px;
      }
      .card h3 {
        margin: 0.6rem 0 0.4rem;
      }
      .muted {
        color: var(--brown);
      }
      .pill {
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 12px;
        color: var(--brown);
        font-size: 0.78rem;
        letter-spacing: 0.04em;
      }

      ul,
      ol {
        padding-left: 1.4rem;
      }
      code {
        font-family: inherit;
        background: var(--codebg);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
      }
      pre {
        background: var(--codebg);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        overflow-x: auto;
      }
      pre code {
        background: none;
        padding: 0;
      }

      /* Generated content variants (rendered via set:html) */
      .variant {
        padding: 24px;
        background: var(--field);
        border: 2px solid var(--line);
        border-radius: 10px;
      }
      .variant h1 {
        margin-top: 0;
      }

      .site-footer {
        border-top: 1px solid var(--line);
        background: var(--paper);
      }
      .site-footer__inner {
        padding: 24px 0;
        font-size: 0.78rem;
        color: var(--brown);
      }
      .tagline {
        margin: 0 0 0.6rem;
      }
      .suite {
        margin: 0;
        opacity: 0.95;
      }
      .suite img {
        vertical-align: -3px;
        margin-right: 0.35rem;
        image-rendering: pixelated;
      }

      .theme-toggle {
        position: fixed;
        top: 0.9rem;
        right: 0.9rem;
        font: inherit;
        font-size: 0.8rem;
        background: var(--paper);
        color: var(--ink);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 0.35rem 0.6rem;
        cursor: pointer;
        z-index: 10;
      }
      .theme-toggle:hover {
        border-color: var(--terra);
        color: var(--terra);
      }
      .theme-toggle:focus-visible {
        outline: 2px solid var(--terra);
        outline-offset: 2px;
      }
    </style>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function current() {
          return (
            document.documentElement.dataset.theme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light')
          );
        }
        function label() {
          btn.textContent = current() === 'dark' ? '☀ claro' : '☾ oscuro';
        }
        label();
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
